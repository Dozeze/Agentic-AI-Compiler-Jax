# Copy to .env.local and fill in. Never commit.
# --provider anthropic (default): the Anthropic API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# --provider anthropic-vertex | gemini-vertex: billed to the GCP project; authenticate once with
#   gcloud auth application-default login   (no key in this file)
GOOGLE_CLOUD_PROJECT=
CLOUD_ML_REGION=global
